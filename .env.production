# =============================================================================
# API — Multi-backend via subdomain
# =============================================================================
# Gunakan SALAH SATU dari dua opsi di bawah:

# Opsi A (multi-backend): {subdomain} akan diganti otomatis dari window.location.hostname
# Contoh: smpn1.sekolah.app → https://smpn1.api.akademihub.id/api/v1
VITE_API_BASE_URL_PATTERN=https://{subdomain}.api.akademihub.id/api/v1

# Opsi B (single/gateway): satu URL eksplisit untuk semua sekolah
# VITE_API_BASE_URL=https://api.akademihub.id/api/v1

# =============================================================================
# WebSocket
# =============================================================================
# URL WebSocket langsung (opsional — default: wss://<hostname>/ws)
# VITE_WS_URL=wss://smpn1.api.akademihub.id/ws

# =============================================================================
# Laravel Reverb / Pusher (Broadcasting)
# =============================================================================
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST={subdomain}.api.akademihub.id
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=wss

# Endpoint autentikasi broadcast (opsional — diturunkan otomatis dari VITE_API_BASE_URL_PATTERN)
# VITE_BROADCAST_AUTH_ENDPOINT=https://{subdomain}.api.akademihub.id/broadcasting/auth
# VITE_BROADCAST_AUTH_BASE_URL=https://{subdomain}.api.akademihub.id/api

# =============================================================================
# Firebase (Push Notification / FCM)
# =============================================================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key
