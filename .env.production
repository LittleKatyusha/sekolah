# app.akademihub.id resolves to app-api.akademihub.id;
# tenant.akademihub.id resolves to tenant-api.akademihub.id.
VITE_API_BASE_URL_PATTERN=https://{subdomain}-api.akademihub.id/api/v1

# Browser traffic reaches Reverb through the public TLS reverse proxy.
VITE_REVERB_APP_KEY=589faa3b7207d8c5d243f596997dad00
VITE_REVERB_HOST={subdomain}-api.akademihub.id
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=wss
